# read-scrolls.lic
module ReadScrolls
  # 101
  SPELLS = {
    101 => 0.33,
    103 => 0.75,
    107 => 0.75,
    112 => 0.33,
    113 => 0.5,
    114 => 0.5,
    115 => 0.33,
    1119 => 1.25,
    1202 => 0.25,
    1204 => 1,
    1601 => 0.25,
    1701 => 0.25,
    1705 => 0.5,
    1711 => 1.0,
    202 => 1.5,
    211 => 1.25,
    213 => 0.33,
    215 => 2.5,
    219 => 1.5,
    303 => 0.75,
    307 => 0.5,
    313 => 1.75,
    315 => 1,
    319 => 2.0,
    401 => 0.33,
    406 => 0.33,
    503 => 0.75,
    507 => 0.75,
    508 => 0.75,
    509 => 1.25,
    511 => 1,
    513 => 1,
    601 => 1,
    602 => 0.33,
    604 => 1.25,
    606 => 3.0,
    608 => 0.33,
    613 => 2.0,
    618 => 3.0,
    712 => 1.5,
    911 => 1.25,
    913 => 1.25,
    916 => 0.5,
  }

  def self.spell_value(spell_num)
    SPELLS[spell_num] || 0
  end

  def self.spell_mana_cost(spell_num)
    spell_num.to_i % 100
  end

  def self.scroll_value_multiplier(total_mana_cost)
    if total_mana_cost <= 5
      1.25
    elsif total_mana_cost >= 40
      0.75
    else
      # Linear interpolation between (5, 1.25) and (40, 0.75)
      1.25 - (total_mana_cost - 5) * (0.5 / 35.0)
    end
  end

  def self.scroll_value(spells_hash)
    sum_spell_values = 0
    total_mana_cost = 0
    spells_hash.each do |spell_num, info|
      count = info[:count]
      sum_spell_values += self.spell_value(spell_num) * count
      total_mana_cost += self.spell_mana_cost(spell_num) * count
    end
    sum_spell_values * self.scroll_value_multiplier(total_mana_cost)
  end

  def self.read_scrolls(container)
    modifier = "on"
    look_result = dothistimeout "look in #{container}", 2, /^In the .*|^On the .*|^That is closed|^I could not find|^There is nothing/
    modifier = "in" if look_result =~ /^In the /

    scrolls = []
    current_scroll = nil
    hook_name = "read_scrolls_#{Time.now.to_i}"

    DownstreamHook.add(hook_name, proc { |line|
      # Strip XML for parsing
      stripped = line.gsub(/<.*?>/, "")
      if stripped =~ /^On the (.*) you see/
        name = $1.strip
        current_scroll = { name: name, spells: {} }
        scrolls << current_scroll
      elsif current_scroll
        unless stripped =~ /.*vibrant.*/
          if stripped =~ /^ +\((\d+)\) (.*)$/
            spell_num = $1.to_i
            spell_name = $2.strip
            if current_scroll[:spells][spell_num]
              current_scroll[:spells][spell_num][:count] += 1
            else
              current_scroll[:spells][spell_num] = { name: spell_name, count: 1 }
            end
          end
        end
      end
      line
    })

    begin
      Script.run("foreach", "scroll #{modifier} #{container};read")
      sleep 0.5
    ensure
      DownstreamHook.remove(hook_name)
    end

    scrolls
  end

  def self.summarize_spells(scrolls)
    summary = {}
    scrolls.each do |scroll|
      scroll[:spells].each do |spell_num, info|
        if summary[spell_num]
          summary[spell_num][:total_count] += info[:count]
        else
          summary[spell_num] = { name: info[:name], total_count: info[:count] }
        end
      end
    end
    summary
  end

  def self.analyze(container)
    if container.nil? || container.empty?
      echo "Usage: ;read-scrolls [my] <container>"
      return
    end

    container = container.strip
    scrolls = read_scrolls(container)
    summary = summarize_spells(scrolls)

    if summary.empty?
      respond "No spells found."
    else
      unimportant, important = summary.partition { |spell_num, _info| !SPELLS.key?(spell_num) }

      unimportant_list = unimportant.map { |num, info| info.merge(num: num) }
      important_list = important.map { |num, info| info.merge(num: num) }

      # Sort from lowest to highest count
      unimportant_list.sort_by! { |info| info[:total_count] }
      important_list.sort_by! { |info| info[:total_count] }

      output = []
      output << '<output class="mono" />'

      unimportant_list.each do |info|
        output << "#{info[:total_count]}: (#{info[:num]}) #{info[:name]}"
      end

      output << "-------------------------------"

      important_list.each do |info|
        output << "#{info[:total_count]}: (#{info[:num]}) #{info[:name]}"
      end

      output << '<output class="" />'

      _respond output.join("\n")

      total_spell_instances = summary.values.inject(0) { |sum, info| sum + info[:total_count] }
      echo "Found #{total_spell_instances} spells on #{scrolls.length} scrolls in '#{container}'"
    end
  end
end

if defined?(script) && script.name.casecmp("read-scrolls") == 0
  ReadScrolls.analyze(script.vars[0])
end
