=begin
  task-skin.lic: A script to loop requesting bounty tasks until a matching skinning task is found.

  Usage: ;task-skin <substring1> [<substring2> ...]
  Example: ;task-skin "giant rat" "large kobold"

  author: Gemini
  game: gs
  tags: bounty, skinning
  version: 0.3
=end

load "#{$script_dir}task-common.lic"

def print_usage
  wrap_mono <<~USAGE
    Usage:
      ;task-skin <substring1> [<substring2> ...]

    Loops requesting bounty tasks until a matching skinning task is found.
    Example: ;task-skin rat kobold
  USAGE
end

if script.vars.empty? || script.vars.include?("help")
  print_usage
  exit
end

targets = script.vars[1..-1]

unless Script.exists?("go2")
  echo "Error: go2 script not found. Please download it using ;repository download go2"
  exit
end

# Enable XML to see prompts and other tags
script.want_downstream_xml = true

def find_guard_command_word
  # Use the last NPC in the room and take the last word of their name.
  npc = GameObj.npcs.reverse.find { |n| n.name }
  return nil unless npc && npc.name
  npc.name.split.last
end

def attempt_furrier_bounty(targets)
  # Navigate to the furrier to check task details
  echo "Navigating to the furrier..."
  Script.run("go2", "furrier")
  sleep 0.5

  furrier_word = find_guard_command_word
  unless furrier_word
    echo "Error: Could not find furrier NPC."
    return false
  end

  echo "Checking bounty details with #{furrier_word}..."
  clear
  put "ask #{furrier_word} for bounty"

  match_found = false
  start_time = Time.now
  # Loop for up to 2 seconds to find a match in the output
  loop do
    line = get?
    if line
      if targets.any? { |t| line =~ /#{Regexp.escape(t)}/ }
        match_found = true
        break
      end
      # Break if we see a prompt, indicating the end of the NPC's response
      # XML prompts look like <prompt time="...">&gt;</prompt>
      break if line =~ /<prompt/ || line =~ /^>/
    elsif Time.now - start_time > 2
      echo "Timeout waiting for furrier response."
      break
    else
      sleep 0.1
    end
  end
  match_found
end

echo "Monitoring for tasks containing: #{targets.join(", ")}"

# Step 3: Loop requesting bounty tasks
loop do
  unless request_bounty("skin")
    echo "Retrying in 10s..."
    sleep 10
    next
  end

  if attempt_furrier_bounty(targets)
    echo "Matching bounty task found! Script complete."
    break
  end

  echo "No match found. Retrying cycle..."
  sleep 1
end
