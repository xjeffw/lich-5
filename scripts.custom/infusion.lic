# infusion.lic
# Infusion helper script for unlocking scroll spells and infusing mana.
#
# Usage:
#   ;infusion unlock <spell_num> [<spell_num> ...]
#   ;infusion infuse
#   ;infusion stock <rune_type|count>
#   ;infusion draw <rune_type>
#   ;infusion brush

load "#{$script_dir}util.lic"
load "#{$script_dir}read-scrolls.lic"

SCROLL_NOUNS = ["scroll", "paper", "palimpsest", "papyrus", "parchment", "vellum"]
RUNE_TYPES = ["jade", "hexagonal", "chalcedony"]
RUNE_TOWNS = { "jade" => "imt", "hexagonal" => "sol", "chalcedony" => "wl" }
RUNE_ITEM_NUMBERS = { "jade" => 24, "hexagonal" => 14, "chalcedony" => 40 }
RUNE_NAMES = { "jade" => "quiss'fyn", "hexagonal" => "odeir'cos", "chalcedony" => "ag'loenar" }
TOWN_ROOMS = { "imt" => "imt", "wl" => "sp", "sol" => "sol" }

def resolve_rune_type(input)
  return nil if input.nil?
  input = input.downcase
  RUNE_TYPES.find { |type| type.start_with?(input) }
end

def find_scroll
  left = GameObj.left_hand
  right = GameObj.right_hand

  left_is_scroll = left && left.noun && SCROLL_NOUNS.include?(left.noun.downcase)
  right_is_scroll = right && right.noun && SCROLL_NOUNS.include?(right.noun.downcase)

  left_is_empty = left.nil? || left.name == "Empty" || left.name.empty?
  right_is_empty = right.nil? || right.name == "Empty" || right.name.empty?

  if left_is_scroll && right_is_empty
    return left
  elsif right_is_scroll && left_is_empty
    return right
  else
    echo "Error: You must have one scroll in one hand and the other hand empty."
    exit
  end
end

def infuse
  scroll = find_scroll
  scroll_noun = scroll.noun

  if scroll.id == GameObj.right_hand.id
    dothistimeout "swap", 3, /^You swap/
  end

  # Ensure other hand is clear
  if GameObj.right_hand.id
    if GameObj.right_hand.noun == "runestone"
      dothistimeout "put my runestone in my dark bag", 3, /^You put/
    else
      dothistimeout "stow right", 3, /^You put|^Stow what|^You are not holding/
    end
  end

  res = dothistimeout "get my chalcedony runestone from my dark bag", 3, /^You (?:get|remove)|^Get what\?|^You already/
  if [GameObj.right_hand, GameObj.left_hand].none? { |obj| obj.name =~ /chalcedony runestone/i }
    echo "Error: Out of chalcedony runestones!"
    exit
  end

  dothistimeout "prep 714", 3, /^You begin|^Your spell is ready/
  dothistimeout "cast my #{scroll_noun}", 3, /^You gesture|^You focus/

  loop {
    if checkmana < 25
      echo "Waiting for mana..."
      while checkmana < 25
        sleep 1
      end
    end

    if [GameObj.right_hand, GameObj.left_hand].none? { |obj| obj.name =~ /chalcedony runestone/i }
      dothistimeout "get my chalcedony runestone from my dark bag", 3, /^You (?:get|remove)|^Get what\?|^You already/
      if [GameObj.right_hand, GameObj.left_hand].none? { |obj| obj.name =~ /chalcedony runestone/i }
        echo "Error: No chalcedony runestone in hand and could not get one!"
        exit
      end
    end

    res = dothistimeout "infuse my #{scroll_noun}", 3, /an infusion of mana leaps|The mana dissipates/
    break if res =~ /The mana dissipates/
    waitrt?
  }

  dothistimeout "put my runestone in my dark bag", 3, /^You put/
  res = dothistimeout "get hexagonal runestone from my dark bag", 3, /^You (?:get|remove)|^Get what\?/
  if res =~ /^Get what\?/
    echo "Error: Out of hexagonal runestones!"
    exit
  end
  dothistimeout "wave my runestone at my #{scroll_noun}", 3, /^You wave/
  dothistimeout "put my runestone in my dark bag", 3, /^You put/
end

def unlock(spell_nums)
  # Ensure spell_nums is an array of strings for matching
  spell_nums = [spell_nums].flatten.map(&:to_s)

  scroll = find_scroll
  scroll_noun = scroll.noun
  Script.current.want_downstream_xml = true

  loop {
    clear
    res = dothistimeout "get hex runestone from my dark bag", 3, /^You (?:get|remove)|^Get what\?|^You already/
    if res =~ /^Get what\?/
      echo "Error: Out of hex runestones!"
      exit
    end
    fput "wave my runestone at my #{scroll_noun}"

    found_spells = []
    locked_spells = []

    # Scan the output for the spell numbers
    while (line = get)
      if line =~ /^\s+\((\d+)\) .* with (.*)$/
        s_num = $1
        s_status = $2
        if spell_nums.include?(s_num)
          found_spells << s_num
          if s_status !~ /and the potential to add/
            locked_spells << s_num
          end
        end
      elsif line =~ /Cast Round/
        break
      else
        sleep 0.1
      end
    end

    waitcastrt?
    sleep 0.2

    # Check if any requested spells were missing
    missing = spell_nums - found_spells
    if !missing.empty?
      echo "Error: Spell(s) #{missing.uniq.join(", ")} not found on the #{scroll_noun}."
      fput "put my hex runestone in my dark bag"
      exit
    end

    if locked_spells.empty?
      echo "Success: All instances of spell(s) #{spell_nums.uniq.join(", ")} are unlocked!"
      # Assuming we should put the runestone away before exiting
      fput "put my hex runestone in my dark bag"
      waitfor "<prompt"
      return
    else
      echo "Spell(s) #{locked_spells.uniq.join(", ")} still locked. Using jade runestone..."
      fput "put my hex runestone in my dark bag"
      waitfor "<prompt"
      res = dothistimeout "get jade runestone from my dark bag", 3, /^You (?:get|remove)|^Get what\?|^You already/
      if res =~ /^Get what\?/
        echo "Error: Out of jade runestones!"
        exit
      end
      fput "wave my runestone at my #{scroll_noun}"
      waitcastrt?
      sleep 0.2
      fput "put my jade runestone in my dark bag"
      waitfor "<prompt"
      # Loop continues to wave the hex runestone again
    end
  }
end

def count_runes(container_name)
  sorter_stopped = stop_sorter
  counts = {}
  RUNE_TYPES.each { |type| counts[type] = 0 }
  was_xml = Script.current.want_downstream_xml
  Script.current.want_downstream_xml = true

  begin
    res = dothistimeout "look in my #{container_name}", 3, /^In the|^I could not find|^That is closed/
    if res.nil? || res =~ /^I could not find|^That is closed/
      return counts
    end

    full_text = res + " "
    while (line = get)
      break if line =~ /<prompt/
      full_text << line.gsub(/<[^>]+>/, "").strip
      full_text << " "
    end

    RUNE_TYPES.each do |rune_type|
      type_pattern = Regexp.escape(rune_type)
      # Split by commas, "and", or colons (for structured view categories)
      parts = full_text.split(/,|\band\b|:/)
      parts.each do |part|
        if part =~ /\b#{type_pattern}\b/i && part =~ /\brunestones?\b/i
          if part =~ /\((\d+)\)/
            counts[rune_type] += $1.to_i
          elsif part =~ /\b(\d+)\s+.*?\b#{type_pattern}/i
            counts[rune_type] += $1.to_i
          else
            counts[rune_type] += 1
          end
        end
      end
    end
  ensure
    Script.current.want_downstream_xml = was_xml
    Script.start("sorter") if sorter_stopped
  end

  counts
end

def count_runes_summary
  rune_counts = count_runes("dark bag")
  supply_counts = count_supplies("dark bag")
  respond "Rune counts:"
  RUNE_TYPES.each do |type|
    respond "  #{type}: #{rune_counts[type]}"
  end
  respond "Supply counts:"
  respond "  ink: #{supply_counts["ink"]}"
  respond "  cup: #{supply_counts["cup"]}"
end

def count_supplies(container_name)
  sorter_stopped = stop_sorter
  counts = { "cup" => 0, "ink" => 0 }
  was_xml = Script.current.want_downstream_xml
  Script.current.want_downstream_xml = true

  begin
    res = dothistimeout "look in my #{container_name}", 3, /^In the|^I could not find|^That is closed/
    if res.nil? || res =~ /^I could not find|^That is closed/
      return counts
    end

    full_text = res + " "
    while (line = get)
      break if line =~ /<prompt/
      full_text << line.gsub(/<[^>]+>/, "").strip
      full_text << " "
    end

    parts = full_text.split(/,|\band\b|:/)
    parts.each do |part|
      part = part.strip.downcase
      if part =~ /\bcup\b/
        if part =~ /\((\d+)\)/
          counts["cup"] += $1.to_i
        elsif part =~ /\b(\d+)\s+.*?\bcup/
          counts["cup"] += $1.to_i
        else
          counts["cup"] += 1
        end
      elsif part =~ /\bink\b/
        if part =~ /\((\d+)\)/
          counts["ink"] += $1.to_i
        elsif part =~ /\b(\d+)\s+.*?\bink/
          counts["ink"] += $1.to_i
        else
          counts["ink"] += 1
        end
      end
    end
  ensure
    Script.current.want_downstream_xml = was_xml
    Script.start("sorter") if sorter_stopped
  end

  counts
end

def stock_supplies
  unless have_container?("dark bag")
    echo "Error: Could not find dark bag!"
    return
  end

  counts = count_supplies("dark bag")
  need_cup = [4 - counts["cup"], 0].max
  need_ink = [4 - counts["ink"], 0].max

  if need_cup == 0 && need_ink == 0
    echo "Supplies already at target levels (cups: #{counts["cup"]}, ink: #{counts["ink"]})."
    return
  end

  echo "Stocking supplies: need #{need_cup} cup(s) and #{need_ink} ink(s)."

  Script.run("warp2", "sp")
  Script.run("go2", "bank")
  stowed_ids = stow_items
  before_dying { restore_items(stowed_ids) }
  fputwait "withdraw 60000"
  Script.run("go2", "alchemist")

  if need_ink > 0
    fputwait "order #{need_ink} of 36"
    fputwait "buy"
    fputwait "open my package"
    fputwait "empty my package into my dark bag"
    fputwait "drop package"
  end

  if need_cup > 0
    fputwait "order #{need_cup} of 37"
    fputwait "buy"
    fputwait "open my package"
    fputwait "empty my package into my dark bag"
    fputwait "drop package"
  end
end

def stock(rune_type)
  if rune_type.to_s.downcase == "count"
    count_runes_summary
    return
  elsif "supplies".start_with?(rune_type.to_s.downcase)
    stock_supplies
    return
  end

  rune_key = resolve_rune_type(rune_type)
  unless rune_key
    echo "Error: Unknown rune type: #{rune_type}. Known types: #{RUNE_TYPES.join(", ")}"
    return
  end

  town = RUNE_TOWNS[rune_key]

  town_room = TOWN_ROOMS[town]
  unless town_room
    echo "Error: Missing town room mapping for #{town}."
    return
  end

  Script.run("go2", town_room.to_s)
  Script.run("go2", "bank")
  stowed_ids = stow_items
  before_dying { restore_items(stowed_ids) }
  fputwait "withdraw 60000"
  Script.run("go2", "alchemist")

  counts = count_runes("dark bag")
  rune_count = counts[rune_key] || 0
  need_runes = 6 - rune_count
  item_number = RUNE_ITEM_NUMBERS[rune_key]
  unless item_number
    echo "Error: Missing rune item number mapping for #{rune_key}."
    return
  end

  if need_runes > 0
    fputwait "order #{need_runes} of #{item_number}"
    fputwait "buy"
    if [GameObj.right_hand, GameObj.left_hand].any? { |obj| obj.noun == "package" }
      fputwait "open my package"
      fputwait "empty my package into my other pack"
      fputwait "drop package"
    elsif [GameObj.right_hand, GameObj.left_hand].any? { |obj| obj.noun == "runestone" }
      fputwait "put my runestone in my pack"
    end
  else
    echo "No runes needed for #{rune_key} (have #{rune_count})."
  end
end

def draw(rune_type)
  rune_key = resolve_rune_type(rune_type)
  unless rune_key
    echo "Error: Unknown rune type: #{rune_type}. Known types: #{RUNE_TYPES.join(", ")}"
    return
  end

  rune_name = RUNE_NAMES[rune_key]

  stowed_ids = stow_items
  before_dying { restore_items(stowed_ids) }

  rune_count = count_runes("pack")[rune_key] || 0
  if rune_count <= 0
    echo "No #{rune_key} runes found in your pack."
    return
  end

  rune_count.times do
    brush
    fput "get #{rune_key} rune from my pack"
    fput "draw #{rune_name} rune on my runestone with my brush"
    sleep 0.2
    waitrt?
    sleep 0.5
    fput "put my runestone in my dark bag"
    sleep 0.2
    fput "put my brush in my dark bag"
    sleep 0.2
  end
end

def brush
  fput "get brush from my dark bag"
  sleep 0.2
  fput "look my brush"
  sleep 0.2
  status = nil

  while (line = get)
    if line =~ /\b(rich|dried|dry|smooth)\b/
      status = $1.downcase
      break
    end
  end

  unless status
    echo "Error: Could not determine brush status."
    return
  end

  if status == "rich"
    return
  end

  if status == "dried" || status == "dry"
    fput "get cup from my dark bag"
    sleep 0.1
    fput "dip brush in my cup"
    sleep 0.1
    fput "put cup in my dark bag"
    sleep 0.1
  end

  fput "get ink from my dark bag"
  sleep 0.1
  fput "dip brush in my ink"
  sleep 0.1
  fput "put ink in my dark bag"
  sleep 0.1
end

def inventory_list
  target_container_names = ["case", "harness", "backpack"]
  results_by_container = {}
  scroll_nouns = SCROLL_NOUNS

  # Search in worn inventory and hands
  all_items = GameObj.inv + [GameObj.left_hand, GameObj.right_hand]

  target_container_names.each do |c_name|
    container = all_items.find { |obj| obj && obj.name =~ /\b#{c_name}\b/i }
    next unless container

    # Ensure container is open and contents are loaded
    fput "look in ##{container.id}"
    res = waitfor "In the ", "On the ", "There is nothing", "That is closed", "I could not find"
    if res =~ /closed/i
      fput "open ##{container.id}"
      fput "look in ##{container.id}"
      waitfor "In the ", "On the ", "There is nothing"
    end

    scrolls = container.contents.select { |obj| obj && obj.noun && scroll_nouns.include?(obj.noun.downcase) }
    next if scrolls.empty?

    results_by_container[container.name] = []

    scrolls.each do |scroll|
      spells = []
      hook_name = "infusion_inv_#{scroll.id}_#{Time.now.to_i}"
      was_xml = Script.current.want_downstream_xml
      Script.current.want_downstream_xml = true

      DownstreamHook.add(hook_name, proc { |line|
        stripped = line.gsub(/<.*?>/, "")
        # Reuse parsing logic from read-scrolls.lic
        unless stripped =~ /vibrant/i
          if stripped =~ /^\s+\((\d+)\) (.*)$/
            spells << "(#{$1}) #{$2.strip}"
          end
        end
        line
      })

      waitrt?
      fput "read ##{scroll.id}"
      waitfor "<prompt"
      DownstreamHook.remove(hook_name)
      Script.current.want_downstream_xml = was_xml

      results_by_container[container.name] << { name: scroll.name, id: scroll.id, spells: spells }
    end
  end

  if results_by_container.empty?
    respond "No scrolls found in case, harness, or backpack."
  else
    respond "Scroll Inventory:"
    results_by_container.each do |c_name, scrolls|
      respond "  #{c_name}:"
      scrolls.each do |r|
        spell_str = r[:spells].join(", ")
        respond "    #{r[:name]} (##{r[:id]}): #{spell_str}"
      end
    end
  end
end

def get_all_scrolls
  target_container_names = ["case", "harness", "backpack"]
  all_scrolls = []
  scroll_nouns = SCROLL_NOUNS

  # Search in worn inventory and hands
  all_items = GameObj.inv + [GameObj.left_hand, GameObj.right_hand]

  target_container_names.each do |c_name|
    container = all_items.find { |obj| obj && obj.name =~ /\b#{c_name}\b/i }
    next unless container

    # Ensure container is open and contents are loaded
    fput "look in ##{container.id}"
    res = waitfor "In the ", "On the ", "There is nothing", "That is closed", "I could not find"
    if res =~ /closed/i
      fput "open ##{container.id}"
      fput "look in ##{container.id}"
      waitfor "In the ", "On the ", "There is nothing"
    end

    scrolls = container.contents.select { |obj| obj && obj.noun && scroll_nouns.include?(obj.noun.downcase) }
    next if scrolls.empty?

    scrolls.each do |scroll|
      spell_info = {}
      hook_name = "infusion_inv_#{scroll.id}_#{Time.now.to_i}"
      was_xml = Script.current.want_downstream_xml
      Script.current.want_downstream_xml = true

      DownstreamHook.add(hook_name, proc { |line|
        stripped = line.gsub(/<.*?>/, "")
        unless stripped =~ /vibrant/i
          if stripped =~ /^\s+\((\d+)\) (.*)$/
            spell_num = $1.to_i
            spell_name = $2.strip
            if spell_info[spell_num]
              spell_info[spell_num][:count] += 1
            else
              spell_info[spell_num] = { name: spell_name, count: 1 }
            end
          end
        end
        line
      })

      waitrt?
      fput "read ##{scroll.id}"
      waitfor "<prompt"
      DownstreamHook.remove(hook_name)
      Script.current.want_downstream_xml = was_xml

      all_scrolls << { name: scroll.name, id: scroll.id, spells: spell_info, current_container: c_name }
    end
  end
  all_scrolls
end

def inventory_auto
  all_scrolls = get_all_scrolls
  if all_scrolls.empty?
    respond "No scrolls found to redistribute."
    return
  end

  desired_spells = ReadScrolls::DESIRED_SPELLS
  spell_values = ReadScrolls::SPELLS

  waiting = all_scrolls.dup
  assignments = { "case" => [], "harness" => [], "backpack" => [] }
  limits = { "case" => 20, "harness" => 30 }
  current_spells = { "case" => Hash.new(0), "harness" => Hash.new(0) }

  # Balanced distribution loop
  while (assignments["case"].length < limits["case"] || assignments["harness"].length < limits["harness"]) && !waiting.empty?
    potential_assignments = []

    waiting.each do |scroll|
      ["case", "harness"].each do |c_name|
        next if assignments[c_name].length >= limits[c_name]

        desired_on_scroll = scroll[:spells].keys.select { |s| desired_spells.include?(s) }

        if desired_on_scroll.empty?
          tier = 999
          count_at_tier = 0
        else
          tier = desired_on_scroll.map { |s| current_spells[c_name][s] }.min + 1
          count_at_tier = desired_on_scroll.count { |s| current_spells[c_name][s] == tier - 1 }
        end

        scroll_score = 0
        scroll[:spells].each do |num, info|
          scroll_score += (spell_values[num] || 0) * info[:count] if desired_spells.include?(num)
        end

        potential_assignments << {
          scroll: scroll,
          container: c_name,
          tier: tier,
          count: count_at_tier,
          score: scroll_score,
        }
      end
    end

    break if potential_assignments.empty?

    # Sort by tier ASC, count DESC, score DESC
    best = potential_assignments.sort_by { |pa| [pa[:tier], -pa[:count], -pa[:score], pa[:container]] }.first

    best_scroll = best[:scroll]
    c_name = best[:container]

    best_scroll[:intended_container] = c_name
    assignments[c_name] << best_scroll
    waiting.delete(best_scroll)

    # Update current spells counts
    best_scroll[:spells].each do |num, info|
      current_spells[c_name][num] += info[:count] if desired_spells.include?(num)
    end
  end

  assignments["backpack"] = waiting
  waiting.each { |s| s[:intended_container] = "backpack" }

  respond "Scroll Redistribution Plan:"
  ["case", "harness", "backpack"].each do |c_name|
    respond "  #{c_name} (#{assignments[c_name].length}):"
    assignments[c_name].each do |s|
      spell_str = s[:spells].map { |num, info| "(#{num}) #{info[:name]}" }.join(", ")
      respond "    #{s[:name]} (##{s[:id]}): #{spell_str}"
    end
  end

  # Find container objects for IDs
  all_items = GameObj.inv + [GameObj.left_hand, GameObj.right_hand]
  container_objs = {}
  ["case", "harness", "backpack"].each do |name|
    container_objs[name] = all_items.find { |obj| obj && obj.name =~ /\b#{name}\b/i }
  end

  unless container_objs["backpack"]
    echo "Error: Could not find backpack to move items into."
    return
  end

  # Step 1: Move scrolls from case/harness to backpack if they belong elsewhere
  echo "Consolidating misplaced scrolls in backpack..."
  all_scrolls.each do |s|
    if ["case", "harness"].include?(s[:current_container]) && s[:current_container] != s[:intended_container]
      waitrt?
      fput "get ##{s[:id]}"
      fput "put ##{s[:id]} in ##{container_objs["backpack"].id}"
    end
  end

  # Step 2: Move intended scrolls to case/harness if they aren't already there
  ["case", "harness"].each do |c_name|
    next if assignments[c_name].empty?
    echo "Filling #{c_name}..."
    unless container_objs[c_name]
      echo "Error: Could not find #{c_name} to move items into."
      next
    end
    assignments[c_name].each do |s|
      if s[:current_container] != c_name
        waitrt?
        fput "get ##{s[:id]}"
        fput "put ##{s[:id]} in ##{container_objs[c_name].id}"
      end
    end
  end

  echo "Redistribution complete."
end

def inventory
  sub_command = Script.current.vars[2]
  if sub_command.nil?
    wrap_mono <<~USAGE
                Usage:
                  ;infusion inventory list
                  ;infusion inventory auto

                list: list scrolls in your case, harness, and backpack with spells and IDs.
                auto: calculate redistribution of scrolls to case (20) and harness (30).
              USAGE
  elsif "list".start_with?(sub_command.downcase)
    inventory_list
  elsif "auto".start_with?(sub_command.downcase)
    inventory_auto
  else
    echo "Error: Unknown inventory sub-command: #{sub_command}. Use ';infusion inventory' for help."
  end
end

def print_infusion_usage
  wrap_mono <<~USAGE
              Usage:
                ;infusion inventory list|auto
                ;infusion unlock spell_num [spell_num ...]
                ;infusion infuse
                ;infusion stock rune_type|count|supplies
                ;infusion draw rune_type
                ;infusion brush

              inventory: manage scroll inventory. (Use ';infusion inventory' for sub-commands)
              unlock: repeatedly uses jade runestones until specified spells are unlocked.
              infuse: link with scroll and repeatedly infuse until full, using chalcedony.
              stock: travel, withdraw silver, and move to the alchemist.
              stock count: count runes and supplies in your dark bag.
              stock supplies: restock ink and cups in your dark bag.
              draw: draw rune names on your runestone using runes in your pack.
              brush: prepare the brush based on its current status.
            USAGE
end

if Script.current.vars[1].nil?
  print_infusion_usage
  exit
elsif "inventory".start_with?(Script.current.vars[1].downcase)
  inventory
elsif Script.current.vars[1].downcase == "unlock"
  if Script.current.vars[2].nil?
    echo "Error: Please specify one or more spell numbers."
  else
    unlock(Script.current.vars[2..-1])
  end
elsif Script.current.vars[1].downcase == "infuse"
  infuse
elsif Script.current.vars[1].downcase == "stock"
  if Script.current.vars[2].nil?
    echo "Error: Please specify a rune type, 'count', or 'supplies'."
  else
    stock(Script.current.vars[2])
  end
elsif Script.current.vars[1].downcase == "draw"
  if Script.current.vars[2].nil?
    echo "Error: Please specify a rune type."
  else
    draw(Script.current.vars[2])
  end
elsif Script.current.vars[1].downcase == "brush"
  brush
else
  print_infusion_usage
end
