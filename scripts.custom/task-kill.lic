=begin
  task-kill.lic: A script to loop requesting bounty tasks until a matching kill task is found.

  Usage: ;task-kill <substring1> [<substring2> ...]
  Example: ;task-kill "giant rat" "large kobold"

  author: Gemini
  game: gs
  tags: bounty, kill
  version: 0.1
=end

load "#{$script_dir}task-common.lic"

def print_usage
  wrap_mono <<~USAGE
    Usage:
      ;task-kill <substring1> [<substring2> ...]

    Loops requesting bounty tasks until a matching kill task is found.
    Example: ;task-kill rat kobold
  USAGE
end

if script.vars.empty? || script.vars.include?("help")
  print_usage
  exit
end

targets = script.vars[1..-1]

unless Script.exists?("go2")
  echo "Error: go2 script not found. Please download it using ;repository download go2"
  exit
end

# Enable XML to see prompts and other tags
script.want_downstream_xml = true

@preferred_guard = "advguard"
@secondary_guard = "advguard2"

def navigate_to_guard
  echo "Navigating to guard location (#{@preferred_guard})..."
  Script.run("go2", @preferred_guard)

  return true if find_guard_command_word

  echo "Guard not found, navigating to secondary location (#{@secondary_guard})..."
  Script.run("go2", @secondary_guard)

  if find_guard_command_word
    # Found at secondary, swap for next time
    @preferred_guard, @secondary_guard = @secondary_guard, @preferred_guard
    return true
  end

  echo "Error: Could not find a guard NPC."
  false
end

def find_guard_command_word
  if Room.current.location =~ /River's Rest/i
    return "purser"
  end
  # Use the last NPC in the room (ignoring "Helga") and take the last word of their name.
  npc = GameObj.npcs.reverse.find { |n| n.name && n.name !~ /Helga/ }
  return nil unless npc && npc.name
  npc.name.split.last
end

def attempt_kill_bounty(targets)
  unless navigate_to_guard
    return false
  end

  guard_word = find_guard_command_word
  unless guard_word
    echo "Error: Guard NPC disappeared!"
    return false
  end

  echo "Checking bounty details with #{guard_word}..."
  clear
  put "ask #{guard_word} for bounty"

  match_found = false
  start_time = Time.now
  # Loop for up to 2 seconds to find a match in the output
  loop do
    line = get?
    if line
      if targets.any? { |t| line =~ /#{Regexp.escape(t)}/ }
        match_found = true
        break
      end
      # Break if we see a prompt, indicating the end of the NPC's response
      # break if line =~ /<prompt/ || line =~ /^>/
    elsif Time.now - start_time > 1
      echo "Timeout waiting for guard response."
      break
    else
      sleep 0.1
    end
  end
  match_found
end

echo "Monitoring for tasks containing: #{targets.join(", ")}"

# Step 3: Loop requesting bounty tasks
loop do
  unless request_bounty("kill")
    echo "Retrying in 10s..."
    sleep 10
    next
  end

  if attempt_kill_bounty(targets)
    echo "Matching bounty task found! Script complete."
    break
  end

  echo "No match found. Retrying cycle..."
  sleep 1
end
